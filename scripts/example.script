# ============================================================
# JanusGraph CLI 示例脚本
# 使用 '#' 或 '//' 开头的行是注释，会被忽略
# 执行方式: script run example.script
# 注意:
#   - 脚本每行是一条命令，不支持交互式换行续行（续行仅在交互 REPL 中可用）
#   - 需要确认的命令请加 -f/--force，或保持注释，否则会误读下一行作为答复
# ============================================================

# ==================== Schema 管理 ====================
# 列出当前所有 Schema 元素（属性键、顶点标签、边标签）
schema list

# 创建属性键（支持类型: String, Integer, Long, Float, Double, Boolean, Date；基数默认 SINGLE）
# schema create key    <name> <type> [SINGLE|LIST|SET]
schema create key uid String
schema create key name String
schema create key age Integer
schema create key email String
schema create key weight Double
schema create key active Boolean
schema create key score Float
schema create key birthday Date

# 查看属性键详情
schema show name
schema show age

# 创建顶点标签
# 语法： schema create vertex <name>
schema create vertex person
schema create vertex company

# 创建边标签（多重性 MULTI|SIMPLE，默认 MULTI）
# schema create edge   <name> [MULTI|SIMPLE]
schema create edge knows
schema create edge works_at

# 查看边标签详情
schema show knows

# Schema 统计
schema stats

# ==================== 数据写入（Gremlin，自动提交） ====================
# 支持任意 Gremlin 读写；写语句执行后自动 commit()
# 新增顶点
query g.addV('person').property('uid','person-1').property('name','marko').property('age',29)
query g.addV('person').property('uid','person-2').property('name','vadas').property('age',27)
query g.addV('company').property('uid','company-1').property('name','acme')

# 新增边：先用 as('a') 标记起点，再由起点 addE 到当前顶点
query g.V().has('name','marko').as('a').V().has('name','vadas').addE('knows').from('a').property('uid','knows-1').property('weight',0.5)
query g.V().has('name','marko').as('a').V().has('name','acme').addE('works_at').from('a').property('uid','worksat-1')

# 其它写入示例
# query g.addV('person').property('uid','person-3').property('name','josh').property('age',32)
# query g.addV('person').property('name','lucy').property('score',0.9f).property('birthday',new Date())
# query g.V().has('name','marko').property('age',30)   # 更新属性
# query g.V().has('name','vadas').drop()               # 删除顶点

# ==================== 索引管理 ====================
# 列出所有索引
index list

# 创建复合索引（类型: String/Integer/Long/Float/Double/Boolean/Date, 元素: vertex/edge）
# 格式: index create <名称> <属性键> <类型> [vertex|edge] [-u]
# 顶点 uid 唯一索引；边 uid 只能普通索引（JanusGraph 唯一索引仅支持顶点）
index create uni_uid uid String vertex -u
index create idx_uid uid String edge
index create uni_name name String vertex -u
index create idx_age age Integer vertex
index create idx_weight weight Double edge
# index create idx_score score Float vertex
# index create idx_birthday birthday Date vertex

# 查看索引状态（期望 ENABLED）
index status uni_uid
index status idx_age

# 查看索引详情
index describe uni_uid

# JSON 格式列出索引
index list --json

# 禁用 / 启用索引
index disable idx_age
index status idx_age
index enable idx_age

# 删除索引（示例：先建一个临时索引再删除；-f 跳过交互确认）
index create idx_email_tmp email String vertex
index drop idx_email_tmp -f

# ==================== 数据查询 ====================
# 统计（全量扫描：会打印 "use indexes" 告警，属正常现象）
query g.V().count()
query g.E().count()
batch count

# 带索引谓词的查询（命中复合索引，不再告警）
query g.V().has('name','marko')
query g.V().has('age',29).count()

# 查看查询是否走索引（观察 profile 输出）
query g.V().has('name','marko').profile()

# 遍历 / 采样
query g.V().limit(10)
query g.V().valueMap()
query g.E().limit(5)
query g.E().valueMap()
batch sample 5

# 兼容写法：可省略 g. 前缀
query V().count()
query V().has('name','marko').limit(10)

# ==================== 数据导入导出 ====================
# 导出数据（CSV 格式）
batch export export.csv

# 导出数据（JSON 格式）
batch export export.json --json

# 导入数据
# batch import data.csv --csv
# batch import data.json --json

# ==================== 备份管理 ====================
# 创建备份
backup create demo-backup

# 列出所有备份
backup list

# 恢复备份
# backup restore demo-backup.json

# 删除备份
# backup delete demo-backup.json

# ==================== 图管理 ====================
# 查看当前图与连接状态
graph current

# 列出可用图（HBase 中以 janusgraph 开头的表）
graph list

# 切换 / 新建图（切换会改变后续操作的落库表，默认注释）
# graph use janusgraph
# graph create janus_demo     # 会要求确认，脚本中请勿直接启用

# ==================== 脚本管理 ====================
# 列出 scripts/ 目录下可用脚本
script list

# ==================== 配置管理 ====================
# 查看当前配置（敏感信息已脱敏）
config show

# ==================== 重新索引 ====================
# 对已有数据重新构建索引（大数据量时耗时较长；会要求确认，脚本中默认注释）
# index reindex uni_name

# ==================== 删除操作（危险，已注释） ====================
# 删除索引
# index drop idx_age -f

# 删除 Schema 元素（key/vertex/edge）
# schema drop key weight
# schema drop vertex person
# schema drop edge knows

# 清空所有数据（必须加 --force 才会执行）
# batch delete-all --force
